<Window x:Class="Loggin.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Loggin.Desktop.Controls"
        Title="Loggin Desktop" Width="1220" Height="780" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen" Icon="Assets/loggin.ico">
    <Grid>
        <!-- Authentication -->
        <Grid Visibility="{Binding IsLoginVisible, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Background="{DynamicResource PrimaryBrush}">
                <Grid Margin="60">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="50" Height="50" CornerRadius="14" Background="#28FFFFFF">
                            <Viewbox Margin="10">
                                <Canvas Width="32" Height="32">
                                    <Path Stroke="White" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M 3,8 L 14,8 M 3,16 L 22,16 M 3,24 L 17,24"/>
                                    <Ellipse Width="8" Height="8" Canvas.Left="21" Canvas.Top="4" Fill="#20C7B7"/>
                                    <Ellipse Width="8" Height="8" Canvas.Left="23" Canvas.Top="20" Fill="#F59E0B"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <TextBlock Text="Loggin" Foreground="White" FontWeight="Bold" FontSize="26"
                                   VerticalAlignment="Center" Margin="14,0,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" MaxWidth="470">
                        <TextBlock Text="Seus eventos.&#x0a;Uma visão clara." Foreground="White"
                                   FontSize="48" FontWeight="Bold" LineHeight="54"/>
                        <TextBlock Margin="0,20,0,0" TextWrapping="Wrap" Foreground="#DFFFFFFF" FontSize="17"
                                   Text="Gerencie coletores, acompanhe logs e identifique atividade em tempo real a partir de um único painel."/>
                    </StackPanel>
                    <TextBlock Grid.Row="2" Text="Observabilidade para Windows • por Artses" Foreground="#BFFFFFFF"/>
                </Grid>
            </Border>
            <Grid Grid.Column="1" Margin="70,45">
                <StackPanel VerticalAlignment="Center" MaxWidth="410">
                    <TextBlock Text="{Binding AuthActionText}" FontSize="31" FontWeight="Bold"/>
                    <TextBlock Text="Conecte-se ao backend Loggin para continuar." Margin="0,8,0,28"
                               Foreground="{DynamicResource MutedTextBrush}"/>
                    <StackPanel Visibility="{Binding IsRegisterMode, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Nome" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding RegistrationName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16"/>
                    </StackPanel>
                    <TextBlock Text="E-mail" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16"/>
                    <TextBlock Text="Senha" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="PasswordInput" PasswordChanged="PasswordInput_OnPasswordChanged" Margin="0,0,0,16"/>
                    <TextBlock Text="Endereço do backend" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding Settings.BackendUrl, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Exemplo: https://localhost:7001/" Margin="0,0,0,22"/>
                    <Button Content="{Binding AuthActionText}" Command="{Binding AuthenticateCommand}" Height="44"/>
                    <Button Margin="0,10,0,0" Style="{StaticResource GhostButton}"
                            Click="ToggleAuthMode_OnClick" Content="Alternar entre entrar e criar conta"/>
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,20,0,0"
                               Foreground="{DynamicResource MutedTextBrush}"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Application shell -->
        <Grid Visibility="{Binding IsShellVisible, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="236"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="4,8,0,30">
                        <Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource PrimaryBrush}">
                            <Viewbox Margin="9">
                                <Canvas Width="32" Height="32">
                                    <Path Stroke="White" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M 3,8 L 14,8 M 3,16 L 22,16 M 3,24 L 17,24"/>
                                    <Ellipse Width="8" Height="8" Canvas.Left="21" Canvas.Top="4" Fill="{DynamicResource SecondaryBrush}"/>
                                    <Ellipse Width="8" Height="8" Canvas.Left="23" Canvas.Top="20" Fill="{DynamicResource AccentBrush}"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="LOGGIN" FontWeight="Bold" FontSize="17"/>
                            <TextBlock Text="DESKTOP" FontSize="10" Foreground="{DynamicResource MutedTextBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Row="1">
                        <Button Content="⌂  Visão geral" Command="{Binding NavigateDashboardCommand}" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Margin="0,0,0,8"/>
                        <Button Content="⬡  Coletores" Command="{Binding NavigateCollectorsCommand}" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Margin="0,0,0,8"/>
                        <Button Content="≡  Fontes e logs" Command="{Binding NavigateLogsCommand}" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Margin="0,0,0,8"/>
                        <Button Content="⚙  Configurações" Command="{Binding NavigateSettingsCommand}" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left"/>
                    </StackPanel>
                    <Border Grid.Row="2" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="10" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding UserName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding ConnectionText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Sair" Command="{Binding LogoutCommand}" Style="{StaticResource GhostButton}" Padding="8,5"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="26,15">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Central de observabilidade" FontWeight="Bold" FontSize="19"/>
                            <TextBlock Text="{Binding LastSyncText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Ellipse Width="9" Height="9" Fill="{DynamicResource SecondaryBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding ConnectionText}" VerticalAlignment="Center"/>
                            <Button Content="Atualizar" Command="{Binding RefreshCommand}" Style="{StaticResource GhostButton}" Margin="18,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="26">
                    <!-- Dashboard -->
                    <ScrollViewer Visibility="{Binding IsDashboardVisible, Converter={StaticResource BoolToVisibility}}" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Visão geral" FontSize="30" FontWeight="Bold"/>
                            <TextBlock Text="Acompanhe a saúde e o volume do seu ambiente." Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,22"/>
                            <UniformGrid Columns="3" Margin="0,0,0,20">
                                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                                    <StackPanel>
                                        <TextBlock Text="COLETORES" Foreground="{DynamicResource MutedTextBrush}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding CollectorCount}" FontSize="34" FontWeight="Bold" Margin="0,8,0,0"/>
                                        <TextBlock Text="agentes configurados" Foreground="{DynamicResource MutedTextBrush}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="6,0">
                                    <StackPanel>
                                        <TextBlock Text="FONTES DE LOG" Foreground="{DynamicResource MutedTextBrush}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding LogCount}" FontSize="34" FontWeight="Bold" Margin="0,8,0,0"/>
                                        <TextBlock Text="caminhos monitorados" Foreground="{DynamicResource MutedTextBrush}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="12,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="LINHAS VISÍVEIS" Foreground="{DynamicResource MutedTextBrush}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding CurrentLineCount}" FontSize="34" FontWeight="Bold" Margin="0,8,0,0"/>
                                        <TextBlock Text="na última coleta" Foreground="{DynamicResource MutedTextBrush}"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Atividade em tempo real" FontSize="18" FontWeight="Bold"/>
                                    <TextBlock Text="Linhas retornadas nas últimas 30 coletas" Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,15"/>
                                    <controls:ActivityChart Values="{Binding ActivityValues}" Height="255"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Collectors -->
                    <Grid Visibility="{Binding IsCollectorsVisible, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.65*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,20">
                            <TextBlock Text="Coletores" FontSize="30" FontWeight="Bold"/>
                            <TextBlock Text="Cadastre os agentes que expõem logs para o orquestrador." Foreground="{DynamicResource MutedTextBrush}"/>
                        </StackPanel>
                        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,10,0">
                            <DataGrid ItemsSource="{Binding Collectors}" SelectedItem="{Binding SelectedCollector}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="Endereço" Binding="{Binding Url}" Width="1.6*"/>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="1.5*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Margin="10,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Detalhes do coletor" FontSize="18" FontWeight="Bold" Margin="0,0,0,18"/>
                                <TextBlock Text="Nome" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding CollectorName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>
                                <TextBlock Text="Host e porta" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding CollectorUrl, UpdateSourceTrigger=PropertyChanged}" ToolTip="Exemplo: 127.0.0.1:8080" Margin="0,0,0,20"/>
                                <Button Content="Salvar coletor" Command="{Binding SaveCollectorCommand}"/>
                                <Button Content="Novo / limpar" Command="{Binding NewCollectorCommand}" Style="{StaticResource GhostButton}" Margin="0,9,0,0"/>
                                <Button Content="Excluir selecionado" Command="{Binding DeleteCollectorCommand}" Style="{StaticResource DangerButton}" Margin="0,9,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Logs -->
                    <Grid Visibility="{Binding IsLogsVisible, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="220"/><RowDefinition/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.6*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,18">
                            <TextBlock Text="Fontes e logs" FontSize="30" FontWeight="Bold"/>
                            <TextBlock Text="Configure caminhos e consulte as linhas retornadas pelo coletor." Foreground="{DynamicResource MutedTextBrush}"/>
                        </StackPanel>
                        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,10,10">
                            <DataGrid ItemsSource="{Binding Logs}" SelectedItem="{Binding SelectedLog}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Caminho" Binding="{Binding Path}" Width="*"/>
                                    <DataGridTextColumn Header="Coletor" Binding="{Binding CollectorId}" Width="1.2*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Margin="10,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Fonte selecionada" FontWeight="Bold" FontSize="17" Margin="0,0,0,12"/>
                                <ComboBox ItemsSource="{Binding Collectors}" SelectedItem="{Binding LogCollector}" DisplayMemberPath="Name" Margin="0,0,0,10"/>
                                <TextBox Text="{Binding LogPath, UpdateSourceTrigger=PropertyChanged}" ToolTip="Caminho do arquivo no host do coletor" Margin="0,0,0,12"/>
                                <WrapPanel>
                                    <Button Content="Salvar" Command="{Binding SaveLogCommand}" Margin="0,0,8,0"/>
                                    <Button Content="Novo" Command="{Binding NewLogCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,0"/>
                                    <Button Content="Excluir" Command="{Binding DeleteLogCommand}" Style="{StaticResource DangerButton}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource Card}" Margin="0,10,0,0">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                                <Grid Margin="0,0,0,12">
                                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="300" HorizontalAlignment="Left" ToolTip="Filtrar linhas"/>
                                    <Button Content="Coletar agora" Command="{Binding FetchLogCommand}" HorizontalAlignment="Right"/>
                                </Grid>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredLogLines}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="#" Binding="{Binding Order}" Width="55"/>
                                        <DataGridTextColumn Header="Horário" Binding="{Binding TimeStamp, StringFormat={}{0:dd/MM HH:mm:ss}}" Width="135"/>
                                        <DataGridTextColumn Header="Linha" Binding="{Binding Line}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Settings -->
                    <ScrollViewer Visibility="{Binding IsSettingsVisible, Converter={StaticResource BoolToVisibility}}" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Configurações" FontSize="30" FontWeight="Bold"/>
                            <TextBlock Text="Personalize a experiência e a conexão." Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,20"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,10,0">
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                                        <StackPanel>
                                            <TextBlock Text="Aparência" FontWeight="Bold" FontSize="18" Margin="0,0,0,14"/>
                                            <TextBlock Text="Tema" Margin="0,0,0,5"/>
                                            <ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding Settings.Theme}" Margin="0,0,0,12"/>
                                            <TextBlock Text="Paleta predefinida" Margin="0,0,0,5"/>
                                            <ComboBox ItemsSource="{Binding Palettes}" SelectionChanged="Palette_OnSelectionChanged" Margin="0,0,0,12"/>
                                            <TextBlock Text="Cor principal" Margin="0,0,0,5"/>
                                            <TextBox Text="{Binding Settings.PrimaryColor, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                                            <TextBlock Text="Cor secundária" Margin="0,0,0,5"/>
                                            <TextBox Text="{Binding Settings.SecondaryColor, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                                            <TextBlock Text="Cor de destaque" Margin="0,0,0,5"/>
                                            <TextBox Text="{Binding Settings.AccentColor, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
                                            <Button Content="Visualizar prévia" Click="PreviewTheme_OnClick" Style="{StaticResource GhostButton}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="Sobre" FontWeight="Bold" FontSize="18"/>
                                            <TextBlock Text="Loggin Desktop" FontWeight="SemiBold" Margin="0,12,0,0"/>
                                            <TextBlock Text="{Binding Version, StringFormat=Versão {0}}" Foreground="{DynamicResource MutedTextBrush}"/>
                                            <TextBlock Text="Autor principal: Artses" Margin="0,8,0,0"/>
                                            <TextBlock Text="Contribuidores: gerados automaticamente nas releases" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"/>
                                            <TextBlock Text="github.com/lucasfhs/Loggin" Foreground="{DynamicResource PrimaryBrush}" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                                        <StackPanel>
                                            <TextBlock Text="Backend e sincronização" FontWeight="Bold" FontSize="18" Margin="0,0,0,14"/>
                                            <TextBlock Text="Endereço base" Margin="0,0,0,5"/>
                                            <TextBox Text="{Binding Settings.BackendUrl, UpdateSourceTrigger=PropertyChanged}" ToolTip="Exemplo: https://localhost:7001/" Margin="0,0,0,12"/>
                                            <TextBlock Text="Timeout (segundos)" Margin="0,0,0,5"/>
                                            <TextBox Text="{Binding Settings.TimeoutSeconds}" Margin="0,0,0,12"/>
                                            <TextBlock Text="Intervalo de atualização (segundos)" Margin="0,0,0,5"/>
                                            <TextBox Text="{Binding Settings.RefreshIntervalSeconds}" Margin="0,0,0,12"/>
                                            <CheckBox Content="Reconectar automaticamente" IsChecked="{Binding Settings.AutoReconnect}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                                        <StackPanel>
                                            <TextBlock Text="Windows e bandeja" FontWeight="Bold" FontSize="18" Margin="0,0,0,12"/>
                                            <CheckBox Content="Iniciar com o Windows" IsChecked="{Binding Settings.StartWithWindows}"/>
                                            <CheckBox Content="Iniciar minimizado" IsChecked="{Binding Settings.StartMinimized}"/>
                                            <CheckBox Content="Minimizar para a bandeja" IsChecked="{Binding Settings.MinimizeToTray}"/>
                                            <CheckBox Content="Ao fechar, continuar na bandeja" IsChecked="{Binding Settings.CloseToTray}"/>
                                        </StackPanel>
                                    </Border>
                                    <Button Content="Salvar configurações" Command="{Binding SaveSettingsCommand}"/>
                                    <Button Content="Restaurar padrões" Command="{Binding ResetSettingsCommand}" Style="{StaticResource GhostButton}" Margin="0,9,0,0"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="26,10">
                    <Grid>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis"/>
                        <ProgressBar IsIndeterminate="True" Height="3" VerticalAlignment="Bottom"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
